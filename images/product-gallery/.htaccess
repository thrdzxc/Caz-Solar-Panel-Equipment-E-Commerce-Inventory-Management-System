Options -Indexes -ExecCGI
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .jpg .png
<FilesMatch "^[a-f0-9]{32}\.jpg$">
    SetHandler default-handler
    ForceType image/jpeg
</FilesMatch>
<FilesMatch "^[a-f0-9]{32}\.png$">
    SetHandler default-handler
    ForceType image/png
</FilesMatch>
<FilesMatch "^(?![a-f0-9]{32}\.(?:jpg|png)$).*$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
